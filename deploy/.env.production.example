PORT=5000
NODE_ENV=production

# Cloud SQL public IP or managed MySQL hostname
# Option A (recommended for Railway / Render):
# MYSQL_URL=mysql://user:password@host:3306/database
# DATABASE_URL=mysql://user:password@host:3306/database

# Option B (separate fields):
DB_HOST=your-cloud-sql-public-ip-or-hostname
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=cln_db

JWT_SECRET=replace-with-a-long-random-secret-generated-locally
JWT_EXPIRES_IN=8h

# Netlify production domain(s)
ALLOWED_ORIGIN=https://dixitlendingsolution.in,https://www.dixitlendingsolution.in
FRONTEND_BASE_URL=https://dixitlendingsolution.in

ALLOWED_IP_PREFIX=
ALLOW_LOCALHOST=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# ─── Email Provider Configuration ─────────────────────────────────────
# Option A: SMTP (Gmail with App Password or dedicated SMTP service)
# Note: Render Free tier blocks outbound SMTP ports 25, 465, and 587.
# For Render Free tier, use Option B (Resend API) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dixitlendingsolution@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Dixit Lending Solution <dixitlendingsolution@gmail.com>

# Option B: Resend API (Recommended for Render, Netlify functions, or cloud hosts that block SMTP ports)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=Dixit Lending Solution <no-reply@yourverifieddomain.com>
# RESEND_DEBUG=false
